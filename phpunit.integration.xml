<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheResult="false"
>
    <testsuites>
        <testsuite name="Real MySQL Redis Concurrency">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="integration" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="mysql" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="dops_integration" force="true"/>
        <env name="DB_USERNAME" value="dops_integration" force="true"/>
        <env name="DB_PASSWORD" value="integration-secret" force="true"/>
        <env name="REDIS_CLIENT" value="phpredis" force="true"/>
        <env name="REDIS_HOST" value="redis" force="true"/>
        <env name="REDIS_PORT" value="6379" force="true"/>
        <env name="CACHE_STORE" value="redis" force="true"/>
        <env name="QUEUE_CONNECTION" value="redis" force="true"/>
        <env name="REDIS_QUEUE_RETRY_AFTER" value="3" force="true"/>
        <env name="SESSION_DRIVER" value="redis" force="true"/>
        <env name="BROADCAST_CONNECTION" value="log" force="true"/>
        <env name="INTEGRATION_BASE_URL" value="http://nginx" force="true"/>
    </php>
</phpunit>
